// ── IQ types that read a code book ───────────────────────────────
// These are not formulas, they are table lookups: ggml casts a table entry to bytes and reads the
// magnitudes out of it. The tables live in gguf_codebooks.flow as byte arrays, which is both what
// ggml sees and what a .flow number can hold exactly.
//
// The one rule that makes these decoders different from the K-quants: a u32 (or u16) is never
// assembled from its bytes. Everything ggml reads out of those words is a nibble or a 7-bit field
// that lives inside one or two bytes, so it is extracted per byte - same discipline as q3k_scale_at,
// and for the same reason: 4*256^3 does not fit a f32 without losing low bits.

// -1 when bit `bit` of the sign byte is set, else +1 (kmask_iq2xs[bit] & signs in ggml).
fn iq_sign(signs, bit)
  let mut iq_cur = signs
  let mut iq_left = bit
  while iq_left > 0.0
    iq_cur = floor(iq_cur / 2.0)
    iq_left = iq_left - 1.0
  end
  if iq_cur - 2.0 * floor(iq_cur / 2.0) == 1.0
    return -1.0
  end
  return 1.0
end

fn dequant_iq3_xxs_block_m(buf, block_off)
  // 256 weights from 98 bytes: d f16 @0, qs[64] @2 (grid indices, one byte per 4 weights), then
  // scales_and_signs[32] @66, which ggml reaches as qs + QK_K/4. Eight sub-blocks of 32; each reads a
  // 4-byte word for its scale nibble (top 4 bits) and four 7-bit indices into ksigns_iq2xs.
  let x_d = read_f16_le_m(buf, block_off)
  let mut x_out = []
  let mut x_ib = 0.0
  while x_ib < 8.0
    let x_s = block_off + 66.0 + 4.0 * x_ib
    let x_b0 = mem_get_u8(buf, x_s)
    let x_b1 = mem_get_u8(buf, x_s + 1.0)
    let x_b2 = mem_get_u8(buf, x_s + 2.0)
    let x_b3 = mem_get_u8(buf, x_s + 3.0)
    let x_db = x_d * (0.5 + floor(x_b3 / 16.0)) * 0.5
    // bits 7l..7l+6 of the group, each assembled from at most the two bytes it spans
    let mut x_fl = []
    push(x_fl, x_b0 - 128.0 * floor(x_b0 / 128.0))
    push(x_fl, floor(x_b0 / 128.0) + (x_b1 - 64.0 * floor(x_b1 / 64.0)) * 2.0)
    push(x_fl, floor(x_b1 / 64.0) + (x_b2 - 32.0 * floor(x_b2 / 32.0)) * 4.0)
    push(x_fl, floor(x_b2 / 32.0) + (x_b3 - 16.0 * floor(x_b3 / 16.0)) * 8.0)
    let mut x_l = 0.0
    while x_l < 4.0
      let x_signs = IQ_KSIGNS[int(x_fl[int(x_l)])]
      // one grid entry is 4 bytes = 4 weights; the low nibble of the pair lands at j, the high at j+4
      let x_g0 = mem_get_u8(buf, block_off + 2.0 + x_ib * 8.0 + x_l * 2.0) * 4.0
      let x_g1 = mem_get_u8(buf, block_off + 2.0 + x_ib * 8.0 + x_l * 2.0 + 1.0) * 4.0
      let mut x_j = 0.0
      while x_j < 4.0
        push(x_out, x_db * IQ3XXS_GRID[int(x_g0 + x_j)] * iq_sign(x_signs, x_j))
        x_j = x_j + 1.0
      end
      let mut x_k = 0.0
      while x_k < 4.0
        push(x_out, x_db * IQ3XXS_GRID[int(x_g1 + x_k)] * iq_sign(x_signs, x_k + 4.0))
        x_k = x_k + 1.0
      end
      x_l = x_l + 1.0
    end
    x_ib = x_ib + 1.0
  end
  return x_out
end

fn dequant_iq2_xxs_block_m(buf, block_off)
  // 256 weights from 66 bytes: d f16 @0, then eight groups of 8 bytes at @2. In each group the first
  // four bytes are indices into iq2xxs_grid (8 magnitudes each) and the last four carry the sub-block
  // scale nibble in the top 4 bits of the last byte plus four 7-bit ksigns_iq2xs indices, exactly as
  // in iq3_xxs but with a 0.25 factor instead of 0.5.
  let z_d = read_f16_le_m(buf, block_off)
  let mut z_out = []
  let mut z_ib = 0.0
  while z_ib < 8.0
    let z_q = block_off + 2.0 + 8.0 * z_ib
    let z_c0 = mem_get_u8(buf, z_q + 4.0)
    let z_c1 = mem_get_u8(buf, z_q + 5.0)
    let z_c2 = mem_get_u8(buf, z_q + 6.0)
    let z_c3 = mem_get_u8(buf, z_q + 7.0)
    let z_db = z_d * (0.5 + floor(z_c3 / 16.0)) * 0.25
    let mut z_fl = []
    push(z_fl, z_c0 - 128.0 * floor(z_c0 / 128.0))
    push(z_fl, floor(z_c0 / 128.0) + (z_c1 - 64.0 * floor(z_c1 / 64.0)) * 2.0)
    push(z_fl, floor(z_c1 / 64.0) + (z_c2 - 32.0 * floor(z_c2 / 32.0)) * 4.0)
    push(z_fl, floor(z_c2 / 32.0) + (z_c3 - 16.0 * floor(z_c3 / 16.0)) * 8.0)
    let mut z_l = 0.0
    while z_l < 4.0
      let z_signs = IQ_KSIGNS[int(z_fl[int(z_l)])]
      let z_g = mem_get_u8(buf, z_q + z_l) * 8.0
      let mut z_j = 0.0
      while z_j < 8.0
        push(z_out, z_db * IQ2XXS_GRID[int(z_g + z_j)] * iq_sign(z_signs, z_j))
        z_j = z_j + 1.0
      end
      z_l = z_l + 1.0
    end
    z_ib = z_ib + 1.0
  end
  return z_out
end

// floor(v / 2^shift), computed by halving: a .flow number cannot hold a shifted 32-bit word exactly,
// and every field these decoders want is 1-4 bits wide, so shifting down then taking the remainder is
// both exact and what the C code's mask means.
fn iq_shr(v, shift)
  let mut q_v = v
  let mut q_n = shift
  while q_n > 0.0
    q_v = floor(q_v / 2.0)
    q_n = q_n - 1.0
  end
  return q_v
end

fn dequant_iq3_s_block_m(buf, block_off)
  // 256 weights from 110 bytes: d f16 @0, qs[64] @2 (grid index, low 8 bits), qh[8] @66 (the 9th bit
  // of each index, one per pair of nibbles... not nibbles - see below), signs[32] @74 (8 sign bits per
  // byte), scales[4] @106 (two 4-bit scales per byte, one per 32-weight sub-block).
  // iq3s_grid has 512 entries, so an index is qs + 256*ext, and ggml gets that ext from qh[0] by
  // (qh[0] << (8-2l)) & 256 for the even slot and (qh[0] << (7-2l)) & 256 for the odd one - i.e. bit
  // 2l and bit 2l+1 of the qh byte. The loop runs two sub-blocks at a time, so 4 passes of qh[0] then
  // qh[1], which is why the scale and signs pointers advance separately.
  let s_d = read_f16_le_m(buf, block_off)
  let mut s_out = []
  let mut s_ib = 0.0
  while s_ib < 8.0
    let s_sc = mem_get_u8(buf, block_off + 106.0 + floor(s_ib / 2.0))
    let s_db1 = s_d * (1.0 + 2.0 * (s_sc - 16.0 * floor(s_sc / 16.0)))
    let s_db2 = s_d * (1.0 + 2.0 * floor(s_sc / 16.0))
    let mut s_h = 0.0
    while s_h < 2.0
      let s_qh = mem_get_u8(buf, block_off + 66.0 + s_ib + s_h)
      let mut s_db = s_db1
      if s_h == 1.0
        s_db = s_db2
      end
      let mut s_l = 0.0
      while s_l < 4.0
        let s_signs = mem_get_u8(buf, block_off + 74.0 + 4.0 * s_ib + 4.0 * s_h + s_l)
        let s_e = 2.0 * s_l
        let s_bit1 = iq_shr(s_qh, s_e) - 2.0 * floor(iq_shr(s_qh, s_e) / 2.0)
        let s_bit2 = iq_shr(s_qh, s_e + 1.0) - 2.0 * floor(iq_shr(s_qh, s_e + 1.0) / 2.0)
        let s_i1 = mem_get_u8(buf, block_off + 2.0 + s_ib * 8.0 + s_h * 8.0 + s_l * 2.0) + 256.0 * s_bit1
        let s_i2 = mem_get_u8(buf, block_off + 2.0 + s_ib * 8.0 + s_h * 8.0 + s_l * 2.0 + 1.0) + 256.0 * s_bit2
        let mut s_j = 0.0
        while s_j < 4.0
          push(s_out, s_db * IQ3S_GRID[int(s_i1 * 4.0 + s_j)] * iq_sign(s_signs, s_j))
          s_j = s_j + 1.0
        end
        let mut s_k = 0.0
        while s_k < 4.0
          push(s_out, s_db * IQ3S_GRID[int(s_i2 * 4.0 + s_k)] * iq_sign(s_signs, s_k + 4.0))
          s_k = s_k + 1.0
        end
        s_l = s_l + 1.0
      end
      s_h = s_h + 1.0
    end
    s_ib = s_ib + 2.0
  end
  return s_out
end

fn dequant_iq2_xs_block_m(buf, block_off)
  // 256 weights from 74 bytes: d f16 @0, then 32 *u16* grid+sign words @2..65, then scales[8] @66.
  // Each word is 9 bits of grid index (iq2xs_grid has 512 entries) and 7 bits of sign-table index, so
  // it fits one f32 exactly (max 65535) and the two fields are a remainder and a shift, not a mask.
  let u_d = read_f16_le_m(buf, block_off)
  let mut u_out = []
  let mut u_ib = 0.0
  while u_ib < 8.0
    let u_sc = mem_get_u8(buf, block_off + 66.0 + u_ib)
    let u_db0 = u_d * (0.5 + (u_sc - 16.0 * floor(u_sc / 16.0))) * 0.25
    let u_db1 = u_d * (0.5 + floor(u_sc / 16.0)) * 0.25
    let mut u_l = 0.0
    while u_l < 4.0
      let u_wl = 2.0 * (u_ib * 4.0 + u_l)
      let u_w = mem_get_u8(buf, block_off + 2.0 + u_wl) + 256.0 * mem_get_u8(buf, block_off + 3.0 + u_wl)
      let mut u_db = u_db0
      if u_l > 1.0
        u_db = u_db1
      end
      let u_signs = IQ_KSIGNS[int(floor(u_w / 512.0))]
      let u_g = (u_w - 512.0 * floor(u_w / 512.0)) * 8.0
      let mut u_j = 0.0
      while u_j < 8.0
        push(u_out, u_db * IQ2XS_GRID[int(u_g + u_j)] * iq_sign(u_signs, u_j))
        u_j = u_j + 1.0
      end
      u_l = u_l + 1.0
    end
    u_ib = u_ib + 1.0
  end
  return u_out
end

// iq1s_grid holds int8_t magnitudes, so a table byte above 127 is negative.
fn iq_i8(b)
  if b > 127.0
    return b - 256.0
  end
  return b
end

fn dequant_iq2_s_block_m(buf, block_off)
  // 256 weights from 82 bytes: d f16 @0, qs[64] @2, qh[8] @66, scales[8] @74. The signs are *not* a
  // separate field: ggml reads them as qs + QK_K/8, i.e. the upper half of qs[] doubles as the sign
  // bytes, so bytes 34..65 are both grid-index material for one sub-block and sign bytes for another.
  // Each sub-block takes 4 grid indices (low 8 bits) plus 2 bits from qh[ib32] each, and one scale
  // byte splits into two 4-bit scales for the first and second half.
  let w_d = read_f16_le_m(buf, block_off)
  let mut w_out = []
  let mut w_ib = 0.0
  while w_ib < 8.0
    let w_sc = mem_get_u8(buf, block_off + 74.0 + w_ib)
    let w_db0 = w_d * (0.5 + (w_sc - 16.0 * floor(w_sc / 16.0))) * 0.25
    let w_db1 = w_d * (0.5 + floor(w_sc / 16.0)) * 0.25
    let w_qh = mem_get_u8(buf, block_off + 66.0 + w_ib)
    let mut w_l = 0.0
    while w_l < 4.0
      let mut w_dl = w_db0
      if w_l > 1.0
        w_dl = w_db1
      end
      let w_sel = iq_shr(w_qh, 2.0 * w_l) - 4.0 * floor(iq_shr(w_qh, 2.0 * w_l) / 4.0)
      let w_idx = mem_get_u8(buf, block_off + 2.0 + w_ib * 4.0 + w_l) + 256.0 * w_sel
      let w_signs = mem_get_u8(buf, block_off + 34.0 + w_ib * 4.0 + w_l)
      let w_g = w_idx * 8.0
      let mut w_j = 0.0
      while w_j < 8.0
        push(w_out, w_dl * IQ2S_GRID[int(w_g + w_j)] * iq_sign(w_signs, w_j))
        w_j = w_j + 1.0
      end
      w_l = w_l + 1.0
    end
    w_ib = w_ib + 1.0
  end
  return w_out
end

fn dequant_iq1_s_block_m(buf, block_off)
  // 256 weights from 50 bytes: d f16 @0, qs[32] @2 (grid index, low 8 bits), qh = 8 u16 @34. Per
  // sub-block the word carries a 3-bit scale at bits 12..14, a sign bit at 15 that becomes the +/-
  // delta of IQ1S_DELTA, and four 3-bit high-index extensions at bits 0..11; the grid is read as
  // int8_t and the delta is *added inside* the scale, so value = dl * (grid[j] + delta).
  let v_d = read_f16_le_m(buf, block_off)
  let mut v_out = []
  let mut v_ib = 0.0
  while v_ib < 8.0
    let v_wl = block_off + 34.0 + 2.0 * v_ib
    let v_q = mem_get_u8(buf, v_wl) + 256.0 * mem_get_u8(buf, v_wl + 1.0)
    let v_sc3 = floor(v_q / 4096.0) - 8.0 * floor(v_q / 32768.0)
    let v_dl = v_d * (2.0 * v_sc3 + 1.0)
    let mut v_delta = 0.125
    if iq_shr(v_q, 15.0) - 2.0 * floor(iq_shr(v_q, 15.0) / 2.0) == 1.0
      v_delta = -0.125
    end
    let mut v_l = 0.0
    while v_l < 4.0
      let v_ext = iq_shr(v_q, 3.0 * v_l) - 8.0 * floor(iq_shr(v_q, 3.0 * v_l) / 8.0)
      let v_idx = mem_get_u8(buf, block_off + 2.0 + v_ib * 4.0 + v_l) + 256.0 * v_ext
      let v_g = v_idx * 8.0
      let mut v_j = 0.0
      while v_j < 8.0
        push(v_out, v_dl * (iq_i8(IQ1S_GRID[int(v_g + v_j)]) + v_delta))
        v_j = v_j + 1.0
      end
      v_l = v_l + 1.0
    end
    v_ib = v_ib + 1.0
  end
  return v_out
end

fn dequant_iq1_m_block_m(buf, block_off)
  // 256 weights from 56 bytes, and the awkward one: there is no d field. qs[32] @0, qh[16] @32,
  // scales[8] @48. The block scale is an f16 *assembled from four nibbles of the eight scale bytes*
  // (ggml-quants.c:2745), each 3-bit group scale likewise, and the delta comes from bits 3 and 7 of
  // the qh bytes. Index extensions are 3 bits: qh[0]&7 for slot 0, (qh[0]>>4)&7 for slot 1, then the
  // same from qh[1]. Same grid as IQ1_S, same value shape.
  let mut y_sc = []
  let mut y_k = 0.0
  while y_k < 4.0
    push(y_sc, mem_get_u8(buf, block_off + 48.0 + 2.0 * y_k) + 256.0 * mem_get_u8(buf, block_off + 49.0 + 2.0 * y_k))
    y_k = y_k + 1.0
  end
  let y_s0 = y_sc[0]
  let y_s1 = y_sc[1]
  let y_s2 = y_sc[2]
  let y_s3 = y_sc[3]
  // (sc[0] >> 12) | ((sc[1] >> 8) & 0xf0) | ((sc[2] >> 4) & 0xf00) | (sc[3] & 0xf000): all four terms
  // take the *top* nibble of one scale word and place it at bit offset 0, 4, 8, 12. The result is the
  // bit pattern of an f16.
  let y_b1 = floor(y_s0 / 4096.0)
  let y_b2 = floor(y_s1 / 4096.0)
  let y_b3 = floor(y_s2 / 4096.0)
  let y_b4 = floor(y_s3 / 4096.0)
  let y_bits = y_b1 + y_b2 * 16.0 + y_b3 * 256.0 + y_b4 * 4096.0
  let y_d = f16_from_bits(y_bits)
  let mut y_out = []
  let mut y_ib = 0.0
  while y_ib < 8.0
    let y_w = y_sc[int(floor(y_ib / 2.0))]
    let y_sh = 6.0 * (y_ib - 2.0 * floor(y_ib / 2.0))
    let y_g1 = iq_shr(y_w, y_sh) - 8.0 * floor(iq_shr(y_w, y_sh) / 8.0)
    let y_g2 = iq_shr(y_w, y_sh + 3.0) - 8.0 * floor(iq_shr(y_w, y_sh + 3.0) / 8.0)
    let y_dl1 = y_d * (2.0 * y_g1 + 1.0)
    let y_dl2 = y_d * (2.0 * y_g2 + 1.0)
    let y_h0 = mem_get_u8(buf, block_off + 32.0 + 2.0 * y_ib)
    let y_h1 = mem_get_u8(buf, block_off + 33.0 + 2.0 * y_ib)
    let mut y_l = 0.0
    while y_l < 4.0
      let mut y_h = y_h0
      if y_l > 1.0
        y_h = y_h1
      end
      let mut y_pos = 0.0
      if y_l - 2.0 * floor(y_l / 2.0) == 1.0
        y_pos = 4.0
      end
      let y_ext = iq_shr(y_h, y_pos) - 8.0 * floor(iq_shr(y_h, y_pos) / 8.0)
      let y_idx = mem_get_u8(buf, block_off + y_ib * 4.0 + y_l) + 256.0 * y_ext
      let mut y_db = y_dl1
      if y_l > 1.0
        y_db = y_dl2
      end
      let mut y_dt = 0.125
      if iq_shr(y_h, y_pos + 3.0) - 2.0 * floor(iq_shr(y_h, y_pos + 3.0) / 2.0) == 1.0
        y_dt = -0.125
      end
      let y_g = y_idx * 8.0
      let mut y_j = 0.0
      while y_j < 8.0
        push(y_out, y_db * (iq_i8(IQ1S_GRID[int(y_g + y_j)]) + y_dt))
        y_j = y_j + 1.0
      end
      y_l = y_l + 1.0
    end
    y_ib = y_ib + 1.0
  end
  return y_out
end

// ── MEM-based Q8_0 / Q5_0 / BF16 dequant ────────────────────────
// Block layouts and value formulas were confirmed element-by-element against ggml's own
// dequantization (an F32 re-quant of the same file), not from a recalled bit layout:
//   q8_0  34 B: d(f16)@0, int8 qs[32]@2         value = d * qs[i]
//   q5_0  22 B: d(f16)@0, u32 qh@2, qs[16]@6    lo nibbles of qs[0..15] -> elements 0..15,
//                                                hi nibbles -> elements 16..31, 5th bit = bit i of qh
//                                                value = (q - 16) * d
// Both nibble schemes and the 5th-bit index were the surprising parts (plane-split, not paired).

fn dequant_q8_0_block_m(buf, block_off)
  let d = read_f16_le_m(buf, block_off)
  let mut out = []
  let mut i = 0.0
  while i < 32.0
    let raw = mem_get_u8(buf, block_off + 2.0 + i)
    let sv = raw - floor(raw / 128.0) * 256.0
    push(out, d * sv)
    i = i + 1.0
  end
  return out
end

fn dequant_q5_0_block_m(buf, block_off)
  let d = read_f16_le_m(buf, block_off)
  let mut out = []
  let mut i = 0.0
  while i < 32.0
    let mut qs_idx = i
    if i >= 16.0
      qs_idx = i - 16.0
    end
    let byte = mem_get_u8(buf, block_off + 6.0 + qs_idx)
    let mut nib = byte - floor(byte / 16.0) * 16.0
    if i >= 16.0
      nib = floor(byte / 16.0)
    end
    // The 5th bit is bit (i mod 8) of the qh byte at (i div 8). Read and shifted per byte on
    // purpose: numbers here are f32, so combining the four bytes into one word would discard the
    // low bits of that word and silently drop the 5th bit for most elements.
    let qh_idx = floor(i / 8.0)
    let qbyte = mem_get_u8(buf, block_off + 2.0 + qh_idx)
    let mut sh = i - 8.0 * qh_idx
    let mut shifted = qbyte
    while sh > 0.0
      shifted = floor(shifted / 2.0)
      sh = sh - 1.0
    end
    let bit = shifted - 2.0 * floor(shifted / 2.0)
    let q = nib + 16.0 * bit
    push(out, (q - 16.0) * d)
    i = i + 1.0
  end
  return out
end

// q6_K: 256 weights from 210 bytes. Element e draws its low nibble from
// ql[64*ip + il + 32*(k mod 2)] (upper nibble when k >= 2) and its two high bits from
// qh[32*ip + il] >> 2*k, with ip = e div 128, k = (e mod 128) div 32, il = (e mod 128) mod 32.
// That scrambled mapping is ggml's to_q6_K; it was checked bit-exactly against an F32 re-quant.
fn dequant_q6_k_block_m(buf, block_off)
  let d = read_f16_le_m(buf, block_off + 208.0)
  let mut out = []
  let mut e = 0.0
  while e < 256.0
    let ip = floor(e / 128.0)
    let r = e - 128.0 * ip
    let k = floor(r / 32.0)
    let il = r - 32.0 * k
    let kb = k - 2.0 * floor(k / 2.0)
    let cell = mem_get_u8(buf, block_off + 64.0 * ip + il + 32.0 * kb)
    let mut q = cell - 16.0 * floor(cell / 16.0)
    if k >= 2.0
      q = floor(cell / 16.0)
    end
    // The two high bits are 2k..2k+1 of one qh byte. Divided out in f32 rather than assembled
    // into a 32-bit word: words built from bytes would overflow the exact-integer range of f32.
    let hib = mem_get_u8(buf, block_off + 128.0 + 32.0 * ip + il)
    let mut div = 1.0
    let mut sh = 0.0
    while sh < k
      div = div * 4.0
      sh = sh + 1.0
    end
    let moved = floor(hib / div)
    q = q + 16.0 * (moved - 4.0 * floor(moved / 4.0))
    let sraw = mem_get_u8(buf, block_off + 192.0 + floor(e / 16.0))
    let s = sraw - 256.0 * floor(sraw / 128.0)
    push(out, d * s * (q - 32.0))
    e = e + 1.0
  end
  return out
end

// ── Load tensor from file (no OOM) ──────────────────────────────
// Reads raw bytes from GGUF file, dequants to f32 array.
// Uses gguf_tensor_file_offset for u64-precise seeking.

fn load_tensor_from_file(file_path, model, tname)
  if gguf_has_tensor(model, tname) == 0.0
    print("WARNING: tensor not found: {tname}")
    let mut _ea3 = []
    return _ea3
  end

  let ttype = gguf_tensor_type(model, tname)
  let count = gguf_tensor_count(model, tname)
  let byte_size = gguf_tensor_byte_size(model, tname)

  // Get precise u64 file offset
  let off_buf = gguf_tensor_file_offset(model, tname)

  // Allocate temp buffer and read raw bytes from file
  let raw = mem_alloc(byte_size)
  let _rd = file_read_into_mem_u64(file_path, raw, off_buf, 0.0, byte_size)
  mem_free(off_buf)

  // Dequant based on type
  let mut result = []

  if ttype == 0.0
    // F32: read directly
    let mut i = 0.0
    while i < count
      let f = bits_to_float(mem_get_u32(raw, i * 4.0))
      push(result, f)
      i = i + 1.0
    end
  elif ttype == 1.0
    // F16: convert each value
    let mut i = 0.0
    while i < count
      let f = read_f16_le_m(raw, i * 2.0)
      push(result, f)
      i = i + 1.0
    end
  elif ttype == 30.0
    // BF16: one 16-bit value per element, exponent-biased like f32 with 8 bits of mantissa.
    let mut i = 0.0
    while i < count
      let b0 = mem_get_u8(raw, i * 2.0)
      let b1 = mem_get_u8(raw, i * 2.0 + 1.0)
      let f = bits_to_float((b0 + b1 * 256.0) * 65536.0)
      push(result, f)
      i = i + 1.0
    end
  elif ttype == 8.0
    // Q8_0: 32 weights from 34 bytes
    let mut b = 0.0
    while b < count / 32.0
      let vals = dequant_q8_0_block_m(raw, b * 34.0)
      let mut vi = 0.0
      while vi < len(vals)
        push(result, vals[int(vi)])
        vi = vi + 1.0
      end
      b = b + 1.0
    end
  elif ttype == 6.0
    // Q5_0: 32 weights from 22 bytes
    let mut b = 0.0
    while b < count / 32.0
      let vals = dequant_q5_0_block_m(raw, b * 22.0)
      let mut vi = 0.0
      while vi < len(vals)
        push(result, vals[int(vi)])
        vi = vi + 1.0
      end
      b = b + 1.0
    end
  elif ttype == 12.0
    // Q4_K: inline dequant — no function calls to avoid O(n^2) clone overhead
    // Q4_K block: 256 weights from 144 bytes
    // Layout: d(f16,2B) + dmin(f16,2B) + scales(12B) + qs(128B) = 144
    let block_size = 256.0
    let block_bytes = 144.0
    let n_blocks = ceil(count / block_size)
    let mut b = 0.0
    while b < n_blocks
      let bo = b * block_bytes
      // Inline F16 decode for d
      let db0 = mem_get_u8(raw, bo)
      let db1 = mem_get_u8(raw, bo + 1.0)
      let d_bits = db0 + db1 * 256.0
      let d_sign = floor(d_bits / 32768.0)
      let d_rem = d_bits - d_sign * 32768.0
      let d_exp = floor(d_rem / 1024.0)
      let d_man = d_rem - d_exp * 1024.0
      let mut d_val = 0.0
      if d_exp > 0.0
        if d_exp < 31.0
          d_val = (1.0 + d_man / 1024.0) * pow(2.0, d_exp - 15.0)
          if d_sign == 1.0
            d_val = d_val * -1.0
          end
        end
      end
      // Inline F16 decode for dmin
      let mb0 = mem_get_u8(raw, bo + 2.0)
      let mb1 = mem_get_u8(raw, bo + 3.0)
      let m_bits = mb0 + mb1 * 256.0
      let m_sign = floor(m_bits / 32768.0)
      let m_rem = m_bits - m_sign * 32768.0
      let m_exp = floor(m_rem / 1024.0)
      let m_man = m_rem - m_exp * 1024.0
      let mut dm_val = 0.0
      if m_exp > 0.0
        if m_exp < 31.0
          dm_val = (1.0 + m_man / 1024.0) * pow(2.0, m_exp - 15.0)
          if m_sign == 1.0
            dm_val = dm_val * -1.0
          end
        end
      end
      let sc_off = bo + 4.0
      let qs_off = bo + 16.0
      // 4 sub-block pairs × 64 weights = 256
      let mut j = 0.0
      let mut q_ptr = qs_off
      let mut is_idx = 0.0
      while j < 4.0
        // Decode scale/min for sub-block pair (inline get_scale_min_k4_m)
        let mut sc1 = 0.0
        let mut mn1 = 0.0
        if is_idx < 4.0
          let sv1 = mem_get_u8(raw, sc_off + is_idx)
          sc1 = sv1 - floor(sv1 / 64.0) * 64.0
          let mv1 = mem_get_u8(raw, sc_off + is_idx + 4.0)
          mn1 = mv1 - floor(mv1 / 64.0) * 64.0
        else
          let qj4_1 = mem_get_u8(raw, sc_off + is_idx + 4.0)
          let qj_4_1 = mem_get_u8(raw, sc_off + is_idx - 4.0)
          let qj0_1 = mem_get_u8(raw, sc_off + is_idx)
          sc1 = (qj4_1 - floor(qj4_1 / 16.0) * 16.0) + floor(qj_4_1 / 64.0) * 16.0
          mn1 = floor(qj4_1 / 16.0) + floor(qj0_1 / 64.0) * 16.0
        end
        let d1 = d_val * sc1
        let m1 = dm_val * mn1
        // Second sub-block
        let is2 = is_idx + 1.0
        let mut sc2 = 0.0
        let mut mn2 = 0.0
        if is2 < 4.0
          let sv2 = mem_get_u8(raw, sc_off + is2)
          sc2 = sv2 - floor(sv2 / 64.0) * 64.0
          let mv2 = mem_get_u8(raw, sc_off + is2 + 4.0)
          mn2 = mv2 - floor(mv2 / 64.0) * 64.0
        else
          let qj4_2 = mem_get_u8(raw, sc_off + is2 + 4.0)
          let qj_4_2 = mem_get_u8(raw, sc_off + is2 - 4.0)
          let qj0_2 = mem_get_u8(raw, sc_off + is2)
          sc2 = (qj4_2 - floor(qj4_2 / 16.0) * 16.0) + floor(qj_4_2 / 64.0) * 16.0
          mn2 = floor(qj4_2 / 16.0) + floor(qj0_2 / 64.0) * 16.0
        end
        let d2 = d_val * sc2
        let m2 = dm_val * mn2
        // 32 weights from low nibbles
        let mut l = 0.0
        while l < 32.0
          let qb = mem_get_u8(raw, q_ptr + l)
          push(result, d1 * (qb - floor(qb / 16.0) * 16.0) - m1)
          l = l + 1.0
        end
        // 32 weights from high nibbles
        let mut l2 = 0.0
        while l2 < 32.0
          let qb2 = mem_get_u8(raw, q_ptr + l2)
          push(result, d2 * floor(qb2 / 16.0) - m2)
          l2 = l2 + 1.0
        end
        q_ptr = q_ptr + 32.0
        is_idx = is_idx + 2.0
        j = j + 1.0
      end
      b = b + 1.0
    end
  elif ttype == 2.0
    // Q4_0: 32 or 256 weights per block, 18.0 bytes each
    let mut bq40 = 0.0
    let mut blkq40 = 0.0
    while bq40 < count / 32.0
      let vq40 = dequant_q4_0_block_m(raw, blkq40)
      let mut iq40 = 0.0
      while iq40 < len(vq40)
        push(result, vq40[int(iq40)])
        iq40 = iq40 + 1.0
      end
      bq40 = bq40 + 1.0
      blkq40 = blkq40 + 18.0
    end
  elif ttype == 3.0
    // Q4_1: 32 or 256 weights per block, 20.0 bytes each
    let mut bq41 = 0.0
    let mut blkq41 = 0.0
    while bq41 < count / 32.0
      let vq41 = dequant_q4_1_block_m(raw, blkq41)
      let mut iq41 = 0.0
      while iq41 < len(vq41)
        push(result, vq41[int(iq41)])
        iq41 = iq41 + 1.0
      end
      bq41 = bq41 + 1.0
      blkq41 = blkq41 + 20.0
    end
  elif ttype == 7.0
    // Q5_1: 32 or 256 weights per block, 24.0 bytes each
    let mut bq51 = 0.0
    let mut blkq51 = 0.0
    while bq51 < count / 32.0
      let vq51 = dequant_q5_1_block_m(raw, blkq51)
      let mut iq51 = 0.0
      while iq51 < len(vq51)
        push(result, vq51[int(iq51)])
        iq51 = iq51 + 1.0
      end
      bq51 = bq51 + 1.0
      blkq51 = blkq51 + 24.0
    end
  elif ttype == 13.0
    // Q5_K: 32 or 256 weights per block, 176.0 bytes each
    let mut bq5kb = 0.0
    let mut blkq5kb = 0.0
    while bq5kb < count / 256.0
      let vq5kb = dequant_q5_k_block_m(raw, blkq5kb)
      let mut iq5kb = 0.0
      while iq5kb < len(vq5kb)
        push(result, vq5kb[int(iq5kb)])
        iq5kb = iq5kb + 1.0
      end
      bq5kb = bq5kb + 1.0
      blkq5kb = blkq5kb + 176.0
    end
  elif ttype == 10.0
    // Q2_K: 256 weights from 84-byte blocks
    let mut bq2k = 0.0
    let mut blkq2k = 0.0
    while bq2k < count / 256.0
      let vq2k = dequant_q2_k_block_m(raw, blkq2k)
      let mut iq2k = 0.0
      while iq2k < len(vq2k)
        push(result, vq2k[int(iq2k)])
        iq2k = iq2k + 1.0
      end
      bq2k = bq2k + 1.0
      blkq2k = blkq2k + 84.0
    end
  elif ttype == 34.0
    // TQ1_0: 256 weights per 54-byte block
    let mut btq1_0 = 0.0
    let mut blktq1_0 = 0.0
    while btq1_0 < count / 256.0
      let vtq1_0 = dequant_tq1_0_block_m(raw, blktq1_0)
      let mut itq1_0 = 0.0
      while itq1_0 < len(vtq1_0)
        push(result, vtq1_0[int(itq1_0)])
        itq1_0 = itq1_0 + 1.0
      end
      btq1_0 = btq1_0 + 1.0
      blktq1_0 = blktq1_0 + 54.0
    end
  elif ttype == 35.0
    // TQ2_0: 256 weights per 66-byte block
    let mut btq2_0 = 0.0
    let mut blktq2_0 = 0.0
    while btq2_0 < count / 256.0
      let vtq2_0 = dequant_tq2_0_block_m(raw, blktq2_0)
      let mut itq2_0 = 0.0
      while itq2_0 < len(vtq2_0)
        push(result, vtq2_0[int(itq2_0)])
        itq2_0 = itq2_0 + 1.0
      end
      btq2_0 = btq2_0 + 1.0
      blktq2_0 = blktq2_0 + 66.0
    end
  elif ttype == 142.0
    // Q2_0_g128 (PQ2_0): 128 weights per 34-byte block
    let mut bg1 = 0.0
    let mut blkg1 = 0.0
    while bg1 < count / 128.0
      let vg1 = dequant_q2_0_g128_block_m(raw, blkg1)
      let mut ig1 = 0.0
      while ig1 < len(vg1)
        push(result, vg1[int(ig1)])
        ig1 = ig1 + 1.0
      end
      bg1 = bg1 + 1.0
      blkg1 = blkg1 + 34.0
    end
  elif ttype == 11.0
    // Q3_K: 256 weights per 110-byte block
    let mut bq3 = 0.0
    let mut blkbq3 = 0.0
    while bq3 < count / 256.0
      let vq3 = dequant_q3_k_block_m(raw, blkbq3)
      let mut iq3 = 0.0
      while iq3 < len(vq3)
        push(result, vq3[int(iq3)])
        iq3 = iq3 + 1.0
      end
      bq3 = bq3 + 1.0
      blkbq3 = blkbq3 + 110.0
    end
  elif ttype == 20.0
    // IQ4_NL: 32 weights per 18-byte block, nonlinear nibble table
    let mut bi4 = 0.0
    let mut blki4 = 0.0
    while bi4 < count / 32.0
      let vi4 = dequant_iq4_nl_block_m(raw, blki4)
      let mut ii4 = 0.0
      while ii4 < len(vi4)
        push(result, vi4[int(ii4)])
        ii4 = ii4 + 1.0
      end
      bi4 = bi4 + 1.0
      blki4 = blki4 + 18.0
    end
  elif ttype == 23.0
    // IQ4_XS: 256 weights per 136-byte block, IQ4_NL code book with per-32 scales
    let mut b4x = 0.0
    let mut blk4x = 0.0
    while b4x < count / 256.0
      let v4x = dequant_iq4_xs_block_m(raw, blk4x)
      let mut i4x = 0.0
      while i4x < len(v4x)
        push(result, v4x[int(i4x)])
        i4x = i4x + 1.0
      end
      b4x = b4x + 1.0
      blk4x = blk4x + 136.0
    end
  elif ttype == 39.0
    // MXFP4: 32 weights per 17-byte block, e8m0 scale and e2m1 nibbles
    let mut bmx = 0.0
    let mut blkmx = 0.0
    while bmx < count / 32.0
      let vmx = dequant_mxfp4_block_m(raw, blkmx)
      let mut imx = 0.0
      while imx < len(vmx)
        push(result, vmx[int(imx)])
        imx = imx + 1.0
      end
      bmx = bmx + 1.0
      blkmx = blkmx + 17.0
    end
  elif ttype == 40.0
    // NVFP4: 64 weights per 36-byte block, four ue4m3 sub-block scales
    let mut bnv = 0.0
    let mut blknv = 0.0
    while bnv < count / 64.0
      let vnv = dequant_nvfp4_block_m(raw, blknv)
      let mut inv = 0.0
      while inv < len(vnv)
        push(result, vnv[int(inv)])
        inv = inv + 1.0
      end
      bnv = bnv + 1.0
      blknv = blknv + 36.0
    end
  elif ttype == 41.0
    // Q1_0: 128 weights per 18-byte block, one bit each
    let mut bq1 = 0.0
    let mut blkq1 = 0.0
    while bq1 < count / 128.0
      let vq1t = dequant_q1_0_block_m(raw, blkq1)
      let mut iq1t = 0.0
      while iq1t < len(vq1t)
        push(result, vq1t[int(iq1t)])
        iq1t = iq1t + 1.0
      end
      bq1 = bq1 + 1.0
      blkq1 = blkq1 + 18.0
    end
  elif ttype == 42.0
    // Q2_0: 64 weights per 18-byte block, two bits each
    let mut bq2 = 0.0
    let mut blkq2 = 0.0
    while bq2 < count / 64.0
      let vq2t = dequant_q2_0_block_m(raw, blkq2)
      let mut iq2t = 0.0
      while iq2t < len(vq2t)
        push(result, vq2t[int(iq2t)])
        iq2t = iq2t + 1.0
      end
      bq2 = bq2 + 1.0
      blkq2 = blkq2 + 18.0
    end
  elif ttype == 16.0
    // IQ2_XXS: 256 weights per 66-byte block, table lookup
    let mut b2x = 0.0
    let mut blk2x = 0.0
    while b2x < count / 256.0
      let v2x = dequant_iq2_xxs_block_m(raw, blk2x)
      let mut i2x = 0.0
      while i2x < len(v2x)
        push(result, v2x[int(i2x)])
        i2x = i2x + 1.0
      end
      b2x = b2x + 1.0
      blk2x = blk2x + 66.0
    end
  elif ttype == 18.0
    // IQ3_XXS: 256 weights per 98-byte block, table lookup
    let mut b3x = 0.0
    let mut blk3x = 0.0
    while b3x < count / 256.0
      let v3x = dequant_iq3_xxs_block_m(raw, blk3x)
      let mut i3x = 0.0
      while i3x < len(v3x)
        push(result, v3x[int(i3x)])
        i3x = i3x + 1.0
      end
      b3x = b3x + 1.0
      blk3x = blk3x + 98.0
    end
  elif ttype == 17.0
    // IQ2_XS: 256 weights per 74-byte block, 512-entry grid
    let mut bux = 0.0
    let mut blknux = 0.0
    while bux < count / 256.0
      let vux = dequant_iq2_xs_block_m(raw, blknux)
      let mut iux = 0.0
      while iux < len(vux)
        push(result, vux[int(iux)])
        iux = iux + 1.0
      end
      bux = bux + 1.0
      blknux = blknux + 74.0
    end
  elif ttype == 21.0
    // IQ3_S: 256 weights per 110-byte block, 512-entry grid
    let mut b3s = 0.0
    let mut blk3s = 0.0
    while b3s < count / 256.0
      let v3s = dequant_iq3_s_block_m(raw, blk3s)
      let mut i3s = 0.0
      while i3s < len(v3s)
        push(result, v3s[int(i3s)])
        i3s = i3s + 1.0
      end
      b3s = b3s + 1.0
      blk3s = blk3s + 110.0
    end
  elif ttype == 22.0
    // IQ2_S: 256 weights per 82-byte block, 1024-entry grid
    let mut b2s = 0.0
    let mut blk2s = 0.0
    while b2s < count / 256.0
      let v2s = dequant_iq2_s_block_m(raw, blk2s)
      let mut i2s = 0.0
      while i2s < len(v2s)
        push(result, v2s[int(i2s)])
        i2s = i2s + 1.0
      end
      b2s = b2s + 1.0
      blk2s = blk2s + 82.0
    end
  elif ttype == 19.0
    // IQ1_S: 256 weights per 50-byte block, 2048-entry signed grid
    let mut b1s = 0.0
    let mut blk1s = 0.0
    while b1s < count / 256.0
      let v1s = dequant_iq1_s_block_m(raw, blk1s)
      let mut i1s = 0.0
      while i1s < len(v1s)
        push(result, v1s[int(i1s)])
        i1s = i1s + 1.0
      end
      b1s = b1s + 1.0
      blk1s = blk1s + 50.0
    end
  elif ttype == 29.0
    // IQ1_M: 256 weights per 56-byte block, no d field
    let mut b1m = 0.0
    let mut blk1m = 0.0
    while b1m < count / 256.0
      let v1m = dequant_iq1_m_block_m(raw, blk1m)
      let mut i1m = 0.0
      while i1m < len(v1m)
        push(result, v1m[int(i1m)])
        i1m = i1m + 1.0
      end
      b1m = b1m + 1.0
      blk1m = blk1m + 56.0
    end
  elif ttype == 14.0
    // Q6_K: 256 weights per 210-byte block, count may end mid-block
    let mut b6 = 0.0
    while b6 < ceil(count / 256.0)
      let vals6 = dequant_q6_k_block_m(raw, b6 * 210.0)
      let mut n6 = 256.0
      let left6 = count - b6 * 256.0
      if left6 < n6
        n6 = left6
      end
      let mut vi6 = 0.0
      while vi6 < n6
        push(result, vals6[int(vi6)])
        vi6 = vi6 + 1.0
      end
      b6 = b6 + 1.0
    end
  else
    assert(false, "load_tensor_from_file: no decoder for ggml type " + str(ttype) + " of " + tname + " (this loader implements every type ggml can dequantize except Q8_1 and the integer/bool types 24..28)")
  end

  mem_free(raw)
  return result
end

// ── Load embedding row from file ─────────────────────────────────

// ── Row / slice loading, one window algorithm for every decoded type ─
//
// A row of a 2-D tensor is a contiguous element range, so reading it needs exactly three things: the
// block geometry of the type (from gguf_type_geometry), the byte range of the blocks that cover the
// range, and the block decoder. All three are already in this module, so the window logic lives here
// once instead of once per type per entry point -- the duplication this replaced is how a wrong Q6_K
// row decoder survived a release (see the branch notes), and the two copies below used to implement
// only four types each while thirteen block decoders existed.
//
// Element and byte positions go through MEM u64 arithmetic (mem_set_u64 / mem_u64_add), never through
// .flow numbers: offsets above 2^24 are not representable as f32 and would round silently.
fn load_element_range_from_file(file_path, off_buf, elem_start, elem_count, ttype)
  let lge_geo = gguf_type_geometry(ttype)
  if len(lge_geo) == 0.0
    assert(false, "load_element_range_from_file: no geometry for ggml type " + str(ttype))
    return []
  end
  let lge_blck = lge_geo[0.0]
  let lge_bb = lge_geo[1.0]

  // Every position below is a .flow number, i.e. an f32, so it is only exact while it is below
  // 2^24. That is a property of the row path this replaces, not a regression: the old code computed
  // token_id * n_embd * 4 the same way and silently rounded once a row began past ~16.7M elements,
  // which is token 18,680 of an 896-wide embedding. The difference is that it now says so.
  if elem_start + elem_count > 16777216.0
    assert(false, "load_element_range_from_file: element range " + str(elem_start) + ".." + str(elem_start + elem_count) + " exceeds the 2^24 exact range of .flow numbers; use gguf_load_tensor() for rows that far into a tensor")
    return []
  end

  // Round out to whole blocks and remember how many leading elements to discard.
  let lge_first = floor(elem_start / lge_blck)
  let lge_lead = elem_start - lge_first * lge_blck
  let lge_nblk = ceil((lge_lead + elem_count) / lge_blck)

  let lge_boff = mem_alloc(8)
  mem_set_u64(lge_boff, 0.0, lge_first * lge_bb)
  let lge_abs = mem_alloc(8)
  let _cp = mem_copy(off_buf, 0.0, lge_abs, 0.0, 8)
  let _ad = mem_u64_add(lge_abs, 0.0, lge_boff, 0.0)
  mem_free(lge_boff)

  let lge_bytes = lge_nblk * lge_bb
  // lge_first * lge_bb stays under 2^24 for the same reason; checked above via the range
  let lge_raw = mem_alloc(lge_bytes)
  let _rd = file_read_into_mem_u64(file_path, lge_raw, lge_abs, 0.0, lge_bytes)
  mem_free(lge_abs)

  let mut lge_out = []
  if lge_blck == 1.0
    // Unquantized: the geometry says one element per "block", so read the range element-wise.
    let mut lge_i = 0.0
    while lge_i < elem_count
      let lge_e = (lge_i + lge_lead) * lge_bb
      if ttype == 0.0
        push(lge_out, bits_to_float(mem_get_u32(lge_raw, lge_e)))
      elif ttype == 1.0
        push(lge_out, read_f16_le_m(lge_raw, lge_e))
      elif ttype == 30.0
        let lge_b0 = mem_get_u8(lge_raw, lge_e)
        let lge_b1 = mem_get_u8(lge_raw, lge_e + 1.0)
        push(lge_out, bits_to_float((lge_b0 + lge_b1 * 256.0) * 65536.0))
      else
        assert(false, "load_element_range_from_file: no element reader for ggml type " + str(ttype))
      end
      lge_i = lge_i + 1.0
    end
    mem_free(lge_raw)
    return lge_out
  end

  let mut lge_b = 0.0
  while lge_b < lge_nblk
    let mut lge_vb = []
    let mut lge_hit = 0.0
    let lge_bo = lge_b * lge_bb
    if ttype == 2.0
      lge_vb = dequant_q4_0_block_m(lge_raw, lge_bo)
      lge_hit = 1.0
    elif ttype == 3.0
      lge_vb = dequant_q4_1_block_m(lge_raw, lge_bo)
      lge_hit = 1.0
    elif ttype == 6.0
      lge_vb = dequant_q5_0_block_m(lge_raw, lge_bo)
      lge_hit = 1.0
    elif ttype == 7.0
      lge_vb = dequant_q5_1_block_m(lge_raw, lge_bo)
      lge_hit = 1.0
    elif ttype == 8.0
      lge_vb = dequant_q8_0_block_m(lge_raw, lge_bo)
      lge_hit = 1.0
    elif ttype == 10.0
      lge_vb = dequant_q2_k_block_m(lge_raw, lge_bo)
      lge_hit = 1.0
    elif ttype == 11.0
      lge_vb = dequant_q3_k_block_m(lge_raw, lge_bo)
      lge_hit = 1.0
    elif ttype == 12.0
      lge_vb = dequant_q4k_block_m(lge_raw, lge_bo)
      lge_hit = 1.0
    elif ttype == 13.0
      lge_vb = dequant_q5_k_block_m(lge_raw, lge_bo)
      lge_hit = 1.0
    elif ttype == 14.0
      lge_vb = dequant_q6_k_block_m(lge_raw, lge_bo)
      lge_hit = 1.0
    elif ttype == 20.0
      lge_vb = dequant_iq4_nl_block_m(lge_raw, lge_bo)
      lge_hit = 1.0
    elif ttype == 34.0
      lge_vb = dequant_tq1_0_block_m(lge_raw, lge_bo)
      lge_hit = 1.0
    elif ttype == 35.0
      lge_vb = dequant_tq2_0_block_m(lge_raw, lge_bo)
      lge_hit = 1.0
    elif ttype == 142.0
      lge_vb = dequant_q2_0_g128_block_m(lge_raw, lge_bo)
      lge_hit = 1.0
    elif ttype == 23.0
      lge_vb = dequant_iq4_xs_block_m(lge_raw, lge_bo)
      lge_hit = 1.0
    elif ttype == 39.0
      lge_vb = dequant_mxfp4_block_m(lge_raw, lge_bo)
      lge_hit = 1.0
    elif ttype == 40.0
      lge_vb = dequant_nvfp4_block_m(lge_raw, lge_bo)
      lge_hit = 1.0
    elif ttype == 41.0
      lge_vb = dequant_q1_0_block_m(lge_raw, lge_bo)
      lge_hit = 1.0
    elif ttype == 42.0
      lge_vb = dequant_q2_0_block_m(lge_raw, lge_bo)
      lge_hit = 1.0
    elif ttype == 16.0
      lge_vb = dequant_iq2_xxs_block_m(lge_raw, lge_bo)
      lge_hit = 1.0
    elif ttype == 18.0
      lge_vb = dequant_iq3_xxs_block_m(lge_raw, lge_bo)
      lge_hit = 1.0
    elif ttype == 17.0
      lge_vb = dequant_iq2_xs_block_m(lge_raw, lge_bo)
      lge_hit = 1.0
    elif ttype == 22.0
      lge_vb = dequant_iq2_s_block_m(lge_raw, lge_bo)
      lge_hit = 1.0
    elif ttype == 19.0
      lge_vb = dequant_iq1_s_block_m(lge_raw, lge_bo)
      lge_hit = 1.0
    elif ttype == 29.0
      lge_vb = dequant_iq1_m_block_m(lge_raw, lge_bo)
      lge_hit = 1.0
    elif ttype == 21.0
      lge_vb = dequant_iq3_s_block_m(lge_raw, lge_bo)
      lge_hit = 1.0
    end
    if lge_hit == 0.0
      mem_free(lge_raw)
      assert(false, "load_element_range_from_file: no block decoder for ggml type " + str(ttype) + " (geometry " + str(lge_blck) + " weights per " + str(lge_bb) + " bytes)")
      return []
    end
    let mut lge_iv = 0.0
    while lge_iv < len(lge_vb)
      push(lge_out, lge_vb[int(lge_iv)])
      lge_iv = lge_iv + 1.0
    end
    lge_b = lge_b + 1.0
  end
  mem_free(lge_raw)

  // Discard the leading elements the range did not ask for, then take elem_count of what is left.
  let mut lge_res = []
  let mut lge_k = lge_lead
  while lge_k < lge_lead + elem_count
    push(lge_res, lge_out[int(lge_k)])
    lge_k = lge_k + 1.0
  end
  return lge_res
end

fn load_embedding_row_from_file(file_path, model, token_id, n_embd)
  let emb_name = "token_embd.weight"
  if gguf_has_tensor(model, emb_name) == 0.0
    // A zero row is a correctly shaped embedding that says nothing about the token, which is the
    // failure mode this loader exists not to hide.
    assert(false, "load_embedding_row_from_file: token_embd.weight not found in this model")
    return []
  end
  let ttype = gguf_tensor_type(model, emb_name)
  let off_buf = gguf_tensor_file_offset(model, emb_name)
  let row = load_element_range_from_file(file_path, off_buf, token_id * n_embd, n_embd, ttype)
  mem_free(off_buf)
  return row
end

fn load_tensor_row_from_file(file_path, model, tname, row_idx, row_size)
  if gguf_has_tensor(model, tname) == 0.0
    print("WARNING: tensor not found: {tname}")
    let mut _rt0 = []
    return _rt0
  end
  let ttype = gguf_tensor_type(model, tname)
  let off_buf = gguf_tensor_file_offset(model, tname)
  let row = load_element_range_from_file(file_path, off_buf, row_idx * row_size, row_size, ttype)
  mem_free(off_buf)
  return row
end

// ══════════════════════════════════════════════════════════════════════
// FAST TENSOR LOADING — Rust OS-boundary dequant (v1.5.0)
// Use gguf_load_tensor(file_path, model, tensor_name) directly.
// It's a Rust builtin: returns GpuFloats array (never cloned).
// Supports: F32, F16, Q4_K, Q5_K (v1.5.0+), Q6_K
// API: gguf_load_tensor(file_path, model_map, "blk.0.attn_q.weight")
// ══════════════════════════════════════════════════════════════════════

// weight_loader.flow — GGUF Weight Loader for LLM Inference
//
// Reads tensors straight from the GGUF file through a Rust MEM buffer, dequantizes to F32, and
// hands arrays back to the caller. One block decoder per ggml format: this module used to carry a
// second set of readers that decoded from an in-memory byte array, and the two copies of the same
// format drifted (the Q6_K row decoder was the one that survived longest). The byte-array set is
// gone; everything reads through the file.
//
// A model map parsed from an in-memory byte array (gguf_load_from_bytes) cannot drive these readers:
// they resolve a tensor offset through the parser MEM buffers (_hdr_buf/_ds_buf), which only
// gguf_load_from_file fills. Write the bytes out and parse the file if you need weights from it.
//
// Uses FLAT key API from gguf.flow — no nested maps.
// Tensor info stored as: t.NAME.type, t.NAME.offset, t.NAME.count, etc.
//
// Decodes: every ggml type that has a dequantizer. 26 block decoders (Q4_0, Q4_1, Q5_0, Q5_1, Q8_0,
// Q2_K, Q3_K, Q4_K, Q5_K, Q6_K, IQ2_XXS, IQ2_XS, IQ3_XXS, IQ1_S, IQ4_NL, IQ3_S, IQ2_S, IQ4_XS, IQ1_M,
// TQ1_0, TQ2_0, MXFP4, NVFP4, Q1_0, Q2_0 and Q2_0_g128/PQ2_0) plus element reads for F32, F16 and
// BF16. What is left out is left out because ggml itself cannot decode it: Q8_1, Q8_K,
// I8/I16/I32/I64/F64 and the removed enum holes all have a null to_float (checked with
// ggml_dequant_dump over types 0..42 and 142).
//
// Every block layout was checked element-by-element against ggml's own dequantization. The tables in
// stdlib/llm/testdata are all [raw block || the floats ggml produced for it], so nothing here rests
// on a recalled bit layout: stdlib/llm/test_dequant.flow (q5_0, q8_0, q6_k),
// stdlib/llm/test_dequant_more.flow (the ten types llama-quantize will write) and
// stdlib/llm/test_row_range.flow, which runs every type that has a fixture through both readers -
// three element windows through load_element_range_from_file and one whole-tensor load through
// load_tensor_from_file, 60544 comparisons in the current 22-type table, all exact.
// Rows and slices go through load_element_range_from_file; a type with geometry but no decoder is an
// assert naming the type, not a silent zero.
//
// Functions (first argument is always the GGUF file path):
//   load_tensor_from_file(file_path, model, tname) → float array, whole tensor
//   load_embedding_row_from_file(file_path, model, token_id, n_embd) → one embedding row
//   load_tensor_row_from_file(file_path, model, tname, row_idx, row_size) → one row of any 2-D tensor
//   load_output_norm(file_path, model) → float array
//   load_output_proj(file_path, model) → float array (falls back to the tied embedding table)
//   read_tensor_by_name(file_path, model, tname) → float array
//
// Requirements: --allow-read (for GGUF file access)

use "gguf"

// ── Layer Weight Loading ───────────────────────────────────────
// NOTE: OctoFlow maps can only store scalars (Float/Str), NOT arrays. So weights are not
// bundled into a map; each one is read by name with read_tensor_by_name() and passed on
// directly. Every format below has exactly one block decoder, in the MEM section.

fn load_output_norm(file_path, model)
  // Load final RMSNorm weights
  let norm_name = "output_norm.weight"
  if gguf_has_tensor(model, norm_name) == 1.0
    return load_tensor_from_file(file_path, model, norm_name)
  end

  print("WARNING: output_norm.weight not found")
  let mut _empty_arr = []
  return _empty_arr
end

fn load_output_proj(file_path, model)
  // Load lm_head projection weights (vocab x n_embd)
  let out_name = "output.weight"
  if gguf_has_tensor(model, out_name) == 1.0
    return load_tensor_from_file(file_path, model, out_name)
  end

  // Some models tie embedding and output weights
  let emb_name = "token_embd.weight"
  if gguf_has_tensor(model, emb_name) == 1.0
    print("NOTE: Using tied embedding weights for output projection")
    return load_tensor_from_file(file_path, model, emb_name)
  end

  print("WARNING: output.weight not found")
  let mut _empty_arr2 = []
  return _empty_arr2
end

// ── Convenience: Read tensor by name ───────────────────────────

fn read_tensor_by_name(file_path, model, tname)
  if gguf_has_tensor(model, tname) == 1.0
    return load_tensor_from_file(file_path, model, tname)
  end

  print("WARNING: tensor not found: {tname}")
  let mut _ea2 = []
  return _ea2
end


fn tensor_name(layer_idx, suffix)
  // Build GGUF tensor name: "blk.{N}.{suffix}"
  return "blk." + str(layer_idx) + "." + suffix
end

// ══════════════════════════════════════════════════════════════════════
// FILE-BASED TENSOR LOADING — reads from file via MEM_TABLE, no OOM.
// For use with gguf_load_from_file() models.
// ══════════════════════════════════════════════════════════════════════

// ── MEM-based F16 decode ─────────────────────────────────────────

// IEEE-754 binary16 given as its 16-bit pattern. Exact for every normal and subnormal; the two
// special cases ggml's own to_float ignores (inf/NaN) return 0.0, matching what it does today.
fn f16_from_bits(bits)
  let f_sign = floor(bits / 32768.0)
  let f_rest = bits - f_sign * 32768.0
  let f_exp = floor(f_rest / 1024.0)
  let f_man = f_rest - f_exp * 1024.0
  if f_exp == 0.0
    if f_man == 0.0
      return 0.0
    end
    let f_val = f_man / 1024.0 * pow(2.0, -14.0)
    if f_sign == 1.0
      return f_val * -1.0
    end
    return f_val
  elif f_exp == 31.0
    return 0.0
  end
  let f_val2 = (1.0 + f_man / 1024.0) * pow(2.0, f_exp - 15.0)
  if f_sign == 1.0
    return f_val2 * -1.0
  end
  return f_val2
end

fn read_f16_le_m(buf, offset)
  return f16_from_bits(mem_get_u8(buf, offset) + mem_get_u8(buf, offset + 1.0) * 256.0)
end

// ── MEM-based Q4_K dequant ───────────────────────────────────────

fn get_scale_min_k4_m(j, buf, scales_off)
  let mut sm = [0.0, 0.0]
  if j < 4.0
    let d_val = mem_get_u8(buf, scales_off + j)
    let d = d_val - floor(d_val / 64.0) * 64.0
    let m_val = mem_get_u8(buf, scales_off + j + 4.0)
    let m = m_val - floor(m_val / 64.0) * 64.0
    sm[0] = d
    sm[1] = m
  else
    let qj4 = mem_get_u8(buf, scales_off + j + 4.0)
    let qj_4 = mem_get_u8(buf, scales_off + j - 4.0)
    let qj0 = mem_get_u8(buf, scales_off + j)
    let low_d = qj4 - floor(qj4 / 16.0) * 16.0
    let high_d = floor(qj_4 / 64.0)
    sm[0] = low_d + high_d * 16.0
    let low_m = floor(qj4 / 16.0)
    let high_m = floor(qj0 / 64.0)
    sm[1] = low_m + high_m * 16.0
  end
  return sm
end

fn dequant_q4k_block_m(buf, block_off)
  let d = read_f16_le_m(buf, block_off)
  let dmin = read_f16_le_m(buf, block_off + 2.0)
  let scales_off = block_off + 4.0
  let qs_off = block_off + 16.0

  let mut _dq4_out = []
  let mut is_idx = 0.0
  let mut q_off = qs_off

  let mut j = 0.0
  while j < 4.0
    let sm1 = get_scale_min_k4_m(is_idx, buf, scales_off)
    let d1 = d * sm1[0]
    let m1 = dmin * sm1[1]
    let sm2 = get_scale_min_k4_m(is_idx + 1.0, buf, scales_off)
    let d2 = d * sm2[0]
    let m2 = dmin * sm2[1]

    let mut l = 0.0
    while l < 32.0
      let q_byte = mem_get_u8(buf, q_off + l)
      let q_low = q_byte - floor(q_byte / 16.0) * 16.0
      push(_dq4_out, d1 * q_low - m1)
      l = l + 1.0
    end

    let mut l2 = 0.0
    while l2 < 32.0
      let q_byte2 = mem_get_u8(buf, q_off + l2)
      let q_high = floor(q_byte2 / 16.0)
      push(_dq4_out, d2 * q_high - m2)
      l2 = l2 + 1.0
    end

    q_off = q_off + 32.0
    is_idx = is_idx + 2.0
    j = j + 1.0
  end
  return _dq4_out
end

// ── bit helper for the 5-bit formats ───────────────────────────
// Shift-and-mask one byte at a time. Assembling the four qh bytes into one word would be wrong
// here: numbers in this language are f32, so bits above the 24th would be discarded silently.
fn bit_at_m(buf, off, shift)
  let bit_byte = mem_get_u8(buf, off)
  let mut bit_left = shift
  let mut bit_cur = bit_byte
  while bit_left > 0.0
    bit_cur = floor(bit_cur / 2.0)
    bit_left = bit_left - 1.0
  end
  return bit_cur - 2.0 * floor(bit_cur / 2.0)
end

// ── MEM-based Q4_0 / Q4_1 / Q5_1 / Q5_K dequant ────────────────

fn dequant_q4_0_block_m(buf, block_off)
  // 32 weights from 18 bytes: d f16 @0, qs[16] @2. Byte j carries weight j in its low nibble and
  // weight j + 16 in its high nibble, so the two halves are emitted as two runs, not as pairs.
  let q40_d = read_f16_le_m(buf, block_off)
  let mut q40_out = []
  let mut q40_j = 0.0
  while q40_j < 16.0
    let q40_b = mem_get_u8(buf, block_off + 2.0 + q40_j)
    push(q40_out, q40_d * (q40_b - floor(q40_b / 16.0) * 16.0 - 8.0))
    q40_j = q40_j + 1.0
  end
  let mut q40_k = 0.0
  while q40_k < 16.0
    let q40_b2 = mem_get_u8(buf, block_off + 2.0 + q40_k)
    push(q40_out, q40_d * (floor(q40_b2 / 16.0) - 8.0))
    q40_k = q40_k + 1.0
  end
  return q40_out
end

fn dequant_q4_1_block_m(buf, block_off)
  // 32 weights from 20 bytes: d f16 @0, m f16 @2, qs[16] @4. Same half-and-half order as q4_0:
  // x = d * q + m, low nibble first for weights 0..15, high nibble for 16..31.
  let q41_d = read_f16_le_m(buf, block_off)
  let q41_m = read_f16_le_m(buf, block_off + 2.0)
  let mut q41_out = []
  let mut q41_j = 0.0
  while q41_j < 16.0
    let q41_b = mem_get_u8(buf, block_off + 4.0 + q41_j)
    push(q41_out, q41_d * (q41_b - floor(q41_b / 16.0) * 16.0) + q41_m)
    q41_j = q41_j + 1.0
  end
  let mut q41_k = 0.0
  while q41_k < 16.0
    let q41_b2 = mem_get_u8(buf, block_off + 4.0 + q41_k)
    push(q41_out, q41_d * floor(q41_b2 / 16.0) + q41_m)
    q41_k = q41_k + 1.0
  end
  return q41_out
end

fn dequant_q5_1_block_m(buf, block_off)
  // 32 weights from 24 bytes: d f16 @0, m f16 @2, h[4] @4 (the 5th bit of each weight), qs[16] @8.
  // Weight j takes bit j of h and the low nibble of qs[j]; weight j + 16 takes bit j + 16 and the
  // high nibble of qs[j]. The 5th bit is read per byte on purpose: numbers here are f32, so joining
  // the four h bytes into one word would discard bits past the 24th.
  let q51_d = read_f16_le_m(buf, block_off)
  let q51_m = read_f16_le_m(buf, block_off + 2.0)
  let mut q51_out = []
  let mut q51_j = 0.0
  while q51_j < 16.0
    let q51_b = mem_get_u8(buf, block_off + 8.0 + q51_j)
    let q51_gb = floor(q51_j / 8.0)
    let q51_bit = bit_at_m(buf, block_off + 4.0 + q51_gb, q51_j - 8.0 * q51_gb)
    push(q51_out, q51_d * (q51_b - floor(q51_b / 16.0) * 16.0 + 16.0 * q51_bit) + q51_m)
    q51_j = q51_j + 1.0
  end
  let mut q51_k = 0.0
  while q51_k < 16.0
    let q51_pos = q51_k + 16.0
    let q51_b2 = mem_get_u8(buf, block_off + 8.0 + q51_k)
    let q51_gb2 = floor(q51_pos / 8.0)
    let q51_bit2 = bit_at_m(buf, block_off + 4.0 + q51_gb2, q51_pos - 8.0 * q51_gb2)
    push(q51_out, q51_d * (floor(q51_b2 / 16.0) + 16.0 * q51_bit2) + q51_m)
    q51_k = q51_k + 1.0
  end
  return q51_out
end

fn dequant_q5_k_block_m(buf, block_off)
  // 256 weights from 176 bytes, as dequantize_row_q5_K does: d f16 @0, dmin f16 @2, scales[12] @4,
  // qh[32] @16, qs[128] @48. Four groups of 64 weights, two 32-weight sub-blocks each, sharing the
  // same 32 qh bytes: group g takes bit 2g of qh[l] for the low nibble and bit 2g+1 for the high.
  // The per-sub-block scale and min come from get_scale_min_k4, the same helper q4_K uses.
  let q5k_d = read_f16_le_m(buf, block_off)
  let q5k_min = read_f16_le_m(buf, block_off + 2.0)
  let q5k_sc = block_off + 4.0
  let q5k_qh = block_off + 16.0
  let q5k_qs = block_off + 48.0
  let mut q5k_out = []
  let mut q5k_g = 0.0
  let mut q5k_is = 0.0
  while q5k_g < 4.0
    let q5k_s1 = get_scale_min_k4_m(q5k_is, buf, q5k_sc)
    let q5k_d1 = q5k_d * q5k_s1[0]
    let q5k_m1 = q5k_min * q5k_s1[1]
    let q5k_s2 = get_scale_min_k4_m(q5k_is + 1.0, buf, q5k_sc)
    let q5k_d2 = q5k_d * q5k_s2[0]
    let q5k_m2 = q5k_min * q5k_s2[1]
    let q5k_b1 = 2.0 * q5k_g
    let q5k_b2 = 2.0 * q5k_g + 1.0
    let mut q5k_l = 0.0
    while q5k_l < 32.0
      let q5k_byte = mem_get_u8(buf, q5k_qs + q5k_g * 32.0 + q5k_l)
      let q5k_lo = q5k_byte - floor(q5k_byte / 16.0) * 16.0
      let q5k_hi = floor(q5k_byte / 16.0)
      let q5k_h1 = bit_at_m(buf, q5k_qh + q5k_l, q5k_b1)
      push(q5k_out, q5k_d1 * (q5k_lo + 16.0 * q5k_h1) - q5k_m1)
      q5k_l = q5k_l + 1.0
    end
    let mut q5k_l2 = 0.0
    while q5k_l2 < 32.0
      let q5k_byte2 = mem_get_u8(buf, q5k_qs + q5k_g * 32.0 + q5k_l2)
      let q5k_hi2 = floor(q5k_byte2 / 16.0)
      let q5k_h2 = bit_at_m(buf, q5k_qh + q5k_l2, q5k_b2)
      push(q5k_out, q5k_d2 * (q5k_hi2 + 16.0 * q5k_h2) - q5k_m2)
      q5k_l2 = q5k_l2 + 1.0
    end
    q5k_is = q5k_is + 2.0
    q5k_g = q5k_g + 1.0
  end
  return q5k_out
end

fn dequant_q2_k_block_m(buf, block_off)
  // 256 weights from 84 bytes, as dequantize_row_q2_K does: scales[16] @0, qs[64] @16,
  // d f16 @80, dmin f16 @82. Sixteen sub-blocks of 16 weights, two per scale byte:
  // dl = d * (s & 0xF) and ml = dmin * (s >> 4). Two passes of 128 weights, each consuming four
  // scale bytes and shifting by 0, 2, 4, 6 into the same 2-bit fields.
  // Field order is scales, quants, then the two halves -- NOT scale-first like q4_K/q5_K.
  let q2k_d = read_f16_le_m(buf, block_off + 80.0)
  let q2k_min = read_f16_le_m(buf, block_off + 82.0)
  let mut q2k_out = []
  let mut q2k_n = 0.0
  while q2k_n < 2.0
    let q2k_q = block_off + 16.0 + q2k_n * 32.0
    let mut q2k_j = 0.0
    while q2k_j < 4.0
      let mut q2k_p = 1.0
      let mut q2k_psh = 2.0 * q2k_j
      while q2k_psh > 0.0
        q2k_p = q2k_p * 2.0
        q2k_psh = q2k_psh - 1.0
      end
      let mut q2k_k = 0.0
      while q2k_k < 2.0
        let q2k_sc = mem_get_u8(buf, block_off + q2k_n * 8.0 + q2k_j * 2.0 + q2k_k)
        let q2k_dl = q2k_d * (q2k_sc - floor(q2k_sc / 16.0) * 16.0)
        let q2k_ml = q2k_min * floor(q2k_sc / 16.0)
        let q2k_boff = q2k_q + q2k_k * 16.0
        let mut q2k_l = 0.0
        while q2k_l < 16.0
          let q2k_b = mem_get_u8(buf, q2k_boff + q2k_l)
          let q2k_sh = floor(q2k_b / q2k_p)
          let q2k_v = q2k_sh - 4.0 * floor(q2k_sh / 4.0)
          push(q2k_out, q2k_dl * q2k_v - q2k_ml)
          q2k_l = q2k_l + 1.0
        end
        q2k_k = q2k_k + 1.0
      end
      q2k_j = q2k_j + 1.0
    end
    q2k_n = q2k_n + 1.0
  end
  return q2k_out
end

// ── MEM-based TQ1_0 / TQ2_0 dequant (ternary, no code book) ─────
// dequantize_row_tq1_0 / dequantize_row_tq2_0 are pure arithmetic, so these need no lookup tables:
// a byte times 3^n, truncated to 8 bits, then xi = (q * 3) >> 8 gives -1, 0 or +1 directly.

fn tq_pow3(n)
  let mut t = 1.0
  let mut k = 0.0
  while k < n
    t = t * 3.0
    k = k + 1.0
  end
  return t
end

fn dequant_tq1_0_block_m(buf, block_off)
  // 256 weights from 54 bytes, as dequantize_row_tq1_0 does: qs[48] @0, qh[4] @48, d f16 @52.
  // The 48 qs bytes split 32 + 16 because the source loops are written in multiples of 32 and 16;
  // each run multiplies the byte by 3^n (n = 0..4, or 0..3 for qh) and keeps only the low 8 bits.
  let t1_d = read_f16_le_m(buf, block_off + 52.0)
  let mut t1_out = []
  let mut t1_g = 0.0
  while t1_g < 2.0
    let t1_base = block_off + t1_g * 32.0
    let mut t1_len = 32.0
    if t1_g == 1.0
      t1_len = 16.0
    end
    let mut t1_n = 0.0
    while t1_n < 5.0
      let t1_p = tq_pow3(t1_n)
      let mut t1_m = 0.0
      while t1_m < t1_len
        let t1_b = mem_get_u8(buf, t1_base + t1_m)
        let t1_qraw = t1_b * t1_p
        let t1_q = t1_qraw - 256.0 * floor(t1_qraw / 256.0)
        let t1_xi = floor(t1_q * 3.0 / 256.0)
        push(t1_out, (t1_xi - 1.0) * t1_d)
        t1_m = t1_m + 1.0
      end
      t1_n = t1_n + 1.0
    end
    t1_g = t1_g + 1.0
  end
  let mut t1_h = 0.0
  while t1_h < 4.0
    let t1_hp = tq_pow3(t1_h)
    let mut t1_j = 0.0
    while t1_j < 4.0
      let t1_hb = mem_get_u8(buf, block_off + 48.0 + t1_j)
      let t1_hr = t1_hb * t1_hp
      let t1_hq = t1_hr - 256.0 * floor(t1_hr / 256.0)
      let t1_hxi = floor(t1_hq * 3.0 / 256.0)
      push(t1_out, (t1_hxi - 1.0) * t1_d)
      t1_j = t1_j + 1.0
    end
    t1_h = t1_h + 1.0
  end
  return t1_out
end

fn dequant_tq2_0_block_m(buf, block_off)
  // 256 weights from 66 bytes: qs[64] @0 (2 bits per weight), d f16 @64. Two runs of 128 weights;
  // within a run the four bit-pairs are taken in order across all 32 bytes, so element order is
  // byte-major per pair, not pair-major per byte.
  let t2_d = read_f16_le_m(buf, block_off + 64.0)
  let mut t2_out = []
  let mut t2_g = 0.0
  while t2_g < 2.0
    let mut t2_l = 0.0
    while t2_l < 4.0
      let mut t2_p = 1.0
      let mut t2_sh = 2.0 * t2_l
      while t2_sh > 0.0
        t2_p = t2_p * 2.0
        t2_sh = t2_sh - 1.0
      end
      let mut t2_m = 0.0
      while t2_m < 32.0
        let t2_b = mem_get_u8(buf, block_off + t2_g * 32.0 + t2_m)
        let t2_s = floor(t2_b / t2_p)
        let t2_q = t2_s - 4.0 * floor(t2_s / 4.0)
        push(t2_out, (t2_q - 1.0) * t2_d)
        t2_m = t2_m + 1.0
      end
      t2_l = t2_l + 1.0
    end
    t2_g = t2_g + 1.0
  end
  return t2_out
end

fn dequant_q2_0_g128_block_m(buf, block_off)
  // 128 weights from 34 bytes: d f16 @0, qs[32] @2, two bits per weight. The code is not the usual
  // offset-binary one -- dequantize_row_q2_0_g128 maps 00=-1, 01=0, 10=+1, 11=+2, i.e. (q - 1) * d,
  // so a block can represent a ternary weight set plus one spare code.
  let g1_d = read_f16_le_m(buf, block_off)
  let mut g1_out = []
  let mut g1_w = 0.0
  while g1_w < 32.0
    let g1_b = mem_get_u8(buf, block_off + 2.0 + g1_w)
    let mut g1_k = 0.0
    while g1_k < 4.0
      let mut g1_p = 1.0
      let mut g1_sh = 2.0 * g1_k
      while g1_sh > 0.0
        g1_p = g1_p * 2.0
        g1_sh = g1_sh - 1.0
      end
      let g1_s = floor(g1_b / g1_p)
      let g1_q = g1_s - 4.0 * floor(g1_s / 4.0)
      push(g1_out, (g1_q - 1.0) * g1_d)
      g1_k = g1_k + 1.0
    end
    g1_w = g1_w + 1.0
  end
  return g1_out
end

// ── MEM-based Q3_K dequant ───────────────────────────────────────
// ggml unpacks q3_K's twelve scale bytes into sixteen 6-bit scales through 32-bit words. Numbers
// here are f32, so that word play is reproduced byte-wise instead: for output scale (W, k) with
// W = idx div 4 and k = idx mod 4, the low nibble comes from scales[(W mod 2)*4 + k] for W = 0,1
// and its high nibble from the same byte for W = 2,3, and the two extension bits sit at positions
// 2W and 2W+1 of scales[8 + k]. 2W never exceeds 6, so the pair never straddles a byte boundary.
fn q3k_scale_at(buf, sc_off, idx)
  let qsa_w = floor(idx / 4.0)
  let qsa_k = idx - 4.0 * qsa_w
  let qsa_wm = qsa_w - 2.0 * floor(qsa_w / 2.0)
  let qsa_hi = floor(qsa_w / 2.0)
  let qsa_nb = mem_get_u8(buf, sc_off + qsa_wm * 4.0 + qsa_k)
  let mut qsa_p = 1.0
  let mut qsa_h = 4.0 * qsa_hi
  while qsa_h > 0.0
    qsa_p = qsa_p * 2.0
    qsa_h = qsa_h - 1.0
  end
  let qsa_v = floor(qsa_nb / qsa_p)
  let qsa_nib = qsa_v - 16.0 * floor(qsa_v / 16.0)
  let mut qsa_e = 1.0
  let mut qsa_s = 2.0 * qsa_w
  while qsa_s > 0.0
    qsa_e = qsa_e * 2.0
    qsa_s = qsa_s - 1.0
  end
  let qsa_xb = mem_get_u8(buf, sc_off + 8.0 + qsa_k)
  let qsa_xs = floor(qsa_xb / qsa_e)
  let qsa_ext = qsa_xs - 4.0 * floor(qsa_xs / 4.0)
  return qsa_nib + 16.0 * qsa_ext
end

fn dequant_q3_k_block_m(buf, block_off)
  // 256 weights from 110 bytes: hmask[32] @0, qs[64] @32, scales[12] @96, d f16 @108. For weight e of
  // the block the 3rd bit comes from hmask[e mod 32] at bit (e div 32), and the 2-bit field from
  // qs[32 + (e div 128)*32 + (e mod 32)] at shift 2*((e div 32) mod 4): the field shift restarts for
  // each 128-weight pass while the hmask bit keeps advancing, because dequantize_row_q3_K declares m
  // outside the n loop. That is what puts one bit per weight on the right element.
  let q3_d = read_f16_le_m(buf, block_off + 108.0)
  let q3_sc = block_off + 96.0
  let mut q3_out = []
  let mut q3_is = 0.0
  let mut q3_n = 0.0
  while q3_n < 2.0
    let q3_qb = block_off + 32.0 + q3_n * 32.0
    let mut q3_j = 0.0
    while q3_j < 4.0
      let mut q3_sp = 1.0
      let mut q3_ssh = 2.0 * q3_j
      while q3_ssh > 0.0
        q3_sp = q3_sp * 2.0
        q3_ssh = q3_ssh - 1.0
      end
      let q3_bit = q3_j + 4.0 * q3_n
      let q3_sc1 = q3k_scale_at(buf, q3_sc, q3_is)
      q3_is = q3_is + 1.0
      let q3_dl1 = q3_d * (q3_sc1 - 32.0)
      let mut q3_l = 0.0
      while q3_l < 16.0
        let q3_b = mem_get_u8(buf, q3_qb + q3_l)
        let q3_s = floor(q3_b / q3_sp)
        let q3_q = q3_s - 4.0 * floor(q3_s / 4.0)
        let q3_h = bit_at_m(buf, block_off + q3_l, q3_bit)
        push(q3_out, q3_dl1 * (q3_q + 4.0 * q3_h - 4.0))
        q3_l = q3_l + 1.0
      end
      let q3_sc2 = q3k_scale_at(buf, q3_sc, q3_is)
      q3_is = q3_is + 1.0
      let q3_dl2 = q3_d * (q3_sc2 - 32.0)
      let mut q3_l2 = 0.0
      while q3_l2 < 16.0
        let q3_b2 = mem_get_u8(buf, q3_qb + 16.0 + q3_l2)
        let q3_s2 = floor(q3_b2 / q3_sp)
        let q3_q2 = q3_s2 - 4.0 * floor(q3_s2 / 4.0)
        let q3_h2 = bit_at_m(buf, block_off + 16.0 + q3_l2, q3_bit)
        push(q3_out, q3_dl2 * (q3_q2 + 4.0 * q3_h2 - 4.0))
        q3_l2 = q3_l2 + 1.0
      end
      q3_j = q3_j + 1.0
    end
    q3_n = q3_n + 1.0
  end
  return q3_out
end

// ── MEM-based IQ4_NL dequant ─────────────────────────────────────
// ggml's kvalues_iq4nl (ggml-common.h:1133), quoted exactly:
//   { -127, -104, -83, -65, -49, -35, -22, -10, 1, 13, 25, 38, 53, 69, 89, 113 }
fn iq4nl_val(k)
  if k == 0.0
    return -127.0
  elif k == 1.0
    return -104.0
  elif k == 2.0
    return -83.0
  elif k == 3.0
    return -65.0
  elif k == 4.0
    return -49.0
  elif k == 5.0
    return -35.0
  elif k == 6.0
    return -22.0
  elif k == 7.0
    return -10.0
  elif k == 8.0
    return 1.0
  elif k == 9.0
    return 13.0
  elif k == 10.0
    return 25.0
  elif k == 11.0
    return 38.0
  elif k == 12.0
    return 53.0
  elif k == 13.0
    return 69.0
  elif k == 14.0
    return 89.0
  elif k == 15.0
    return 113.0
  end
  assert(false, "iq4nl_val: nibble out of range " + str(k))
  return 0.0
end

fn dequant_iq4_nl_block_m(buf, block_off)
  // 32 weights from 18 bytes: d f16 @0, qs[16] @2. Same split-nibble order as q4_0 -- byte j
  // holds weight j in its low nibble and weight j + 16 in its high nibble -- but the value is
  // d * kvalues_iq4nl[nibble], a nonlinear 16-entry code book, which is why this is a separate
  // type and not just Q4_0 with a different scale.
  let i4_d = read_f16_le_m(buf, block_off)
  let mut i4_out = []
  let mut i4_j = 0.0
  while i4_j < 16.0
    let i4_b = mem_get_u8(buf, block_off + 2.0 + i4_j)
    push(i4_out, i4_d * iq4nl_val(i4_b - floor(i4_b / 16.0) * 16.0))
    i4_j = i4_j + 1.0
  end
  let mut i4_k = 0.0
  while i4_k < 16.0
    let i4_b2 = mem_get_u8(buf, block_off + 2.0 + i4_k)
    push(i4_out, i4_d * iq4nl_val(floor(i4_b2 / 16.0)))
    i4_k = i4_k + 1.0
  end
  return i4_out
end

// ── e2m1 (MXFP4 / NVFP4) and the remaining block types ──────────

// kvalues_fp4: the OCP MX E2M1 set, doubled so the shared scale helper can hand the factor of two
// back. ggml-impl.h:477 returns 2^(e-128) where the e8m0 exponent alone would say 2^(e-127), and the
// comment there is explicit that this exists because "the E0M2 values are doubled". Index 8 is -0.0,
// which is why a code book of sixteen e2m1 codes only produces fifteen distinct magnitudes.
fn fp4_val(k)
  if k == 0.0
    return 0.0
  elif k == 1.0
    return 1.0
  elif k == 2.0
    return 2.0
  elif k == 3.0
    return 3.0
  elif k == 4.0
    return 4.0
  elif k == 5.0
    return 6.0
  elif k == 6.0
    return 8.0
  elif k == 7.0
    return 12.0
  elif k == 8.0
    return 0.0
  elif k == 9.0
    return -1.0
  elif k == 10.0
    return -2.0
  elif k == 11.0
    return -3.0
  elif k == 12.0
    return -4.0
  elif k == 13.0
    return -6.0
  elif k == 14.0
    return -8.0
  end
  return -12.0
end

// UE4M3 sub-block scale, halved for the same reason. 0x7F is the all-ones pattern ggml maps to 0
// rather than NaN. The exponent field is four bits, so it has to be masked off bit 7 of the byte.
fn fp4_ue4m3(x)
  if x == 0.0
    return 0.0
  end
  if x == 127.0
    return 0.0
  end
  let u4_exp = floor(x / 8.0) - 16.0 * floor(x / 128.0)
  let u4_man = x - 8.0 * floor(x / 8.0)
  if u4_exp == 0.0
    return u4_man * 0.001953125 * 0.5
  end
  return (1.0 + u4_man / 8.0) * pow(2.0, u4_exp - 7.0) * 0.5
end

fn dequant_mxfp4_block_m(buf, block_off)
  // 32 weights from 17 bytes: e u8 (E8M0) @0, qs[16] @1. Split-nibble order again -- byte j is
  // weight j in the low nibble and weight j+16 in the high one.
  let m4_e = mem_get_u8(buf, block_off)
  let m4_d = pow(2.0, m4_e - 128.0)
  let mut m4_out = []
  let mut m4_j = 0.0
  while m4_j < 16.0
    let m4_b = mem_get_u8(buf, block_off + 1.0 + m4_j)
    push(m4_out, m4_d * fp4_val(m4_b - floor(m4_b / 16.0) * 16.0))
    m4_j = m4_j + 1.0
  end
  let mut m4_k = 0.0
  while m4_k < 16.0
    let m4_b2 = mem_get_u8(buf, block_off + 1.0 + m4_k)
    push(m4_out, m4_d * fp4_val(floor(m4_b2 / 16.0)))
    m4_k = m4_k + 1.0
  end
  return m4_out
end

fn dequant_nvfp4_block_m(buf, block_off)
  // 64 weights from 36 bytes: four UE4M3 scales @0..3, one per 16-element sub-block, then qs[32] @4.
  // The sub-block is 16 wide, so a byte carries weight j and weight j+8 of the *same* sub-block --
  // unlike MXFP4/IQ4_NL where the high nibble lands half a block (16) away.
  let mut n4_out = []
  let mut n4_s = 0.0
  while n4_s < 4.0
    let n4_d = fp4_ue4m3(mem_get_u8(buf, block_off + n4_s))
    let mut n4_j = 0.0
    while n4_j < 8.0
      let n4_b = mem_get_u8(buf, block_off + 4.0 + n4_s * 8.0 + n4_j)
      push(n4_out, n4_d * fp4_val(n4_b - floor(n4_b / 16.0) * 16.0))
      n4_j = n4_j + 1.0
    end
    let mut n4_k = 0.0
    while n4_k < 8.0
      let n4_b2 = mem_get_u8(buf, block_off + 4.0 + n4_s * 8.0 + n4_k)
      push(n4_out, n4_d * fp4_val(floor(n4_b2 / 16.0)))
      n4_k = n4_k + 1.0
    end
    n4_s = n4_s + 1.0
  end
  return n4_out
end

fn dequant_q1_0_block_m(buf, block_off)
  // 128 weights from 18 bytes: d f16 @0..1, qs[16] @2, one bit per weight, LSB first. The bit picks
  // between +d and -d; there is no zero and no offset, so (2*bit - 1) * d is the whole codec.
  let q1_d = read_f16_le_m(buf, block_off)
  let mut q1_out = []
  let mut q1_w = 0.0
  while q1_w < 16.0
    let mut q1_k = 0.0
    while q1_k < 8.0
      let q1_b = bit_at_m(buf, block_off + 2.0 + q1_w, q1_k)
      push(q1_out, q1_d * (2.0 * q1_b - 1.0))
      q1_k = q1_k + 1.0
    end
    q1_w = q1_w + 1.0
  end
  return q1_out
end

fn dequant_q2_0_block_m(buf, block_off)
  // 64 weights from 18 bytes: d f16 @0..1, qs[16] @2, two bits per weight, code q is (q - 1) * d. Same
  // codec as Q2_0_g128 (type 142) at group 64, so type 42 and type 142 differ only in how many
  // weights share one scale.
  let g2_d = read_f16_le_m(buf, block_off)
  let mut g2_out = []
  let mut g2_w = 0.0
  while g2_w < 16.0
    let g2_b = mem_get_u8(buf, block_off + 2.0 + g2_w)
    let mut g2_k = 0.0
    while g2_k < 4.0
      let mut g2_p = 1.0
      let mut g2_sh = 2.0 * g2_k
      while g2_sh > 0.0
        g2_p = g2_p * 2.0
        g2_sh = g2_sh - 1.0
      end
      let g2_s = floor(g2_b / g2_p)
      push(g2_out, (g2_s - 4.0 * floor(g2_s / 4.0) - 1.0) * g2_d)
      g2_k = g2_k + 1.0
    end
    g2_w = g2_w + 1.0
  end
  return g2_out
end

fn dequant_iq4_xs_block_m(buf, block_off)
  // 256 weights from 136 bytes: d f16 @0, scales_h u16 @2, scales_l[4] @4, qs[128] @8. Eight
  // sub-blocks of 32, each with a 6-bit scale made of 4 bits from scales_l and 2 bits from
  // scales_h, applied as d * (scale - 32) to IQ4_NL's nibble table. So this is IQ4_NL with
  // per-32-block scales rather than a per-block one, and the scale is split across two fields,
  // which is why the low 4 bits must be joined to the high 2 rather than read from one place.
  let ix_d = read_f16_le_m(buf, block_off)
  let ix_h = mem_get_u8(buf, block_off + 2.0) + mem_get_u8(buf, block_off + 3.0) * 256.0
  let mut ix_out = []
  let mut ix_ib = 0.0
  while ix_ib < 8.0
    let mut ix_p = 1.0
    let mut ix_c = 4.0 * (ix_ib - 2.0 * floor(ix_ib / 2.0))
    while ix_c > 0.0
      ix_p = ix_p * 2.0
      ix_c = ix_c - 1.0
    end
    let ix_l = mem_get_u8(buf, block_off + 4.0 + floor(ix_ib / 2.0))
    let ix_s4 = floor(ix_l / ix_p) - 16.0 * floor(ix_l / (ix_p * 16.0))
    let mut ix_qp = 1.0
    let mut ix_qc = 2.0 * ix_ib
    while ix_qc > 0.0
      ix_qp = ix_qp * 2.0
      ix_qc = ix_qc - 1.0
    end
    let ix_h2 = floor(ix_h / ix_qp) - 4.0 * floor(ix_h / (ix_qp * 4.0))
    let ix_dl = ix_d * (ix_s4 + ix_h2 * 16.0 - 32.0)
    let mut ix_j = 0.0
    while ix_j < 16.0
      let ix_b = mem_get_u8(buf, block_off + 8.0 + ix_ib * 16.0 + ix_j)
      push(ix_out, ix_dl * iq4nl_val(ix_b - floor(ix_b / 16.0) * 16.0))
      ix_j = ix_j + 1.0
    end
    let mut ix_k = 0.0
    while ix_k < 16.0
      let ix_b2 = mem_get_u8(buf, block_off + 8.0 + ix_ib * 16.0 + ix_k)
      push(ix_out, ix_dl * iq4nl_val(floor(ix_b2 / 16.0)))
      ix_k = ix_k + 1.0
    end
    ix_ib = ix_ib + 1.0
  end
  return ix_out
end

// ── IQ code books ──────────────────────────────────────────────────────
//
// ggml's IQ dequantizers do not compute a magnitude from an index, they cast a table entry to
// bytes and read them: "(const uint8_t *)(iq3xxs_grid + idx)" (ggml-quants.c:2662). So each entry
// below is stored as its own bytes, little-endian, which is exactly what that cast sees, and each
// comment names the C type it came from. Byte storage is also the only form a .flow number can
// hold: numbers here are f32, so an integer above 2^24 rounds silently and a u32 or u64 table
// entry cannot be kept in one at all - a byte always can.
//
// Generated from the fork's ggml-common.h by .octoflow_probe/extract_iq_tables.js +
// gen_codebooks.js, never typed by hand: a wrong entry is not an error, it is one weight with a
// plausible value. stdlib/llm/test_dequant_iq.flow checks every type that uses these against
// ggml's own to_float on real blocks.

// kmask_iq2xs: 8 entries x 1 byte(s) -- uint8_t[8], ggml-common.h:522
let IQ_KMASK = [1, 2, 4, 8, 16, 32, 64, 128]

// ksigns_iq2xs: 128 entries x 1 byte(s) -- uint8_t[128], ggml-common.h:526
let IQ_KSIGNS = [0, 129, 130, 3, 132, 5, 6, 135, 136, 9, 10, 139, 12, 141, 142, 15, 144, 17, 18, 147, 20, 149, 150, 23, 24, 153, 154, 27, 156, 29, 30, 159, 160, 33, 34, 163, 36, 165, 166, 39, 40, 169, 170, 43, 172, 45, 46, 175, 48, 177, 178, 51, 180, 53, 54, 183, 184, 57, 58, 187, 60, 189, 190, 63, 192, 65, 66, 195, 68, 197, 198, 71, 72, 201, 202, 75, 204, 77, 78, 207, 80, 209, 210, 83, 212, 85, 86, 215, 216, 89, 90, 219, 92, 221, 222, 95, 96, 225, 226, 99, 228, 101, 102, 231, 232, 105, 106, 235, 108, 237, 238, 111, 240, 113, 114, 243, 116, 245, 246, 119, 120, 249, 250, 123, 252, 125, 126, 255]

